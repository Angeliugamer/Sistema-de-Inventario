<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" stylesheets="@../Styles/Botones.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.ListProductController">
   <children>
      <Pane prefHeight="200.0" prefWidth="200.0">
         <children>
            <ImageView fitHeight="720.0" fitWidth="1280.0" pickOnBounds="true" preserveRatio="true">
               <image><Image url="@../Shared/1%20Login/Fondo.png" /></image>
            </ImageView>
            <ImageView fitHeight="720.0" fitWidth="1280.0" pickOnBounds="true" preserveRatio="true">
               <image><Image url="@../Shared/2%20Lista%20Productos/Coso%20Astetic.png" /></image>
            </ImageView>
            <ImageView fitHeight="497.0" fitWidth="872.0" layoutX="59.0" layoutY="147.0" pickOnBounds="true" preserveRatio="true">
               <image><Image url="@../Shared/2%20Lista%20Productos/Espacio%20para%20la%20lista.png" /></image>
            </ImageView>
         </children>
      </Pane>
      <Pane prefHeight="200.0" prefWidth="200.0">
         <children>
            <ImageView fitHeight="56.0" fitWidth="57.0" layoutX="23.0" layoutY="22.0" pickOnBounds="true" preserveRatio="true">
               <image><Image url="@../Icons/SignOut.png" /></image>
               <effect><ColorAdjust brightness="1.0" /></effect>
            </ImageView>
            <ImageView fitHeight="60.0" fitWidth="63.0" layoutX="1108.0" layoutY="26.0" pickOnBounds="true" preserveRatio="true">
               <image><Image url="@../Icons/ShoppingCart.png" /></image>
               <effect><ColorAdjust brightness="1.0" /></effect>
            </ImageView>
            <ImageView fitHeight="96.0" fitWidth="96.0" layoutX="1182.0" layoutY="5.0" pickOnBounds="true" preserveRatio="true">
               <image><Image url="@../Icons/UserCircle.png" /></image>
               <effect><ColorAdjust brightness="1.0" /></effect>
            </ImageView>
            <ImageView fitHeight="60.0" fitWidth="63.0" layoutX="1190.0" layoutY="580.0" pickOnBounds="true" preserveRatio="true">
               <image><Image url="@../Icons/GearSix.png" /></image>
               <effect><ColorAdjust brightness="1.0" /></effect>
            </ImageView>
         </children>
      </Pane>
      <Pane prefHeight="200.0" prefWidth="200.0">
         <children>
            <Button fx:id="Out" layoutX="25.0" layoutY="22.0" mnemonicParsing="false" onAction="#logout" prefHeight="56.0" prefWidth="52.0" styleClass="boton-navegacion" />
            <Button fx:id="Shop" layoutX="1108.0" layoutY="26.0" mnemonicParsing="false" onAction="#openShop" prefHeight="60.0" prefWidth="60.0" styleClass="boton-navegacion" />

            <GridPane hgap="8" layoutX="61.0" layoutY="122.0" prefHeight="25.0" prefWidth="866.0">
               <columnConstraints>
                  <ColumnConstraints percentWidth="48" />
                  <ColumnConstraints percentWidth="18" />
                  <ColumnConstraints percentWidth="16" />
                  <ColumnConstraints percentWidth="18" />
               </columnConstraints>

               <Label text="PRODUCTO" GridPane.columnIndex="0" />
               <Label text="PRECIO" GridPane.columnIndex="1" />
               <Label text="STOCK" GridPane.columnIndex="2" />
               <Label text="CANT." GridPane.columnIndex="3" />
               <rowConstraints>
                  <RowConstraints />
               </rowConstraints>
            </GridPane>

            <ListView fx:id="ListProd" layoutX="61.0" layoutY="148.0" prefHeight="491.0" prefWidth="866.0" styleClass="lista-productos" />

            <Label layoutX="995.0" layoutY="130.0" text="Acciones del Carrito">
               <font><Font name="Arial Black" size="14.0" /></font>
            </Label>
            <TextField fx:id="BarraBusqueda" layoutX="959.0" layoutY="155.0" prefHeight="26.0" prefWidth="229.0" promptText="Busqueda">
               <font><Font name="Arial" size="12.0" /></font>
            </TextField>
            <Button fx:id="BtnBusqueda" layoutX="1202.0" layoutY="155.0" mnemonicParsing="false" onAction="#buscarProductos" styleClass="boton-naranja" text="Buscar">
               <font><Font name="Arial" size="12.0" /></font>
            </Button>
            <Label layoutX="1040.0" layoutY="195.0" text="Cantidad">
               <font><Font name="Arial Bold" size="14.0" /></font>
            </Label>
            <TextField fx:id="Cantidad" layoutX="959.0" layoutY="220.0" prefHeight="26.0" prefWidth="229.0" promptText="Cantidad (1 por defecto)">
               <font><Font name="Arial" size="12.0" /></font>
            </TextField>
            <Button fx:id="BtnAñadir" layoutX="1000.0" layoutY="260.0" mnemonicParsing="false" onAction="#añadirAlCarrito" styleClass="boton-naranja" text="Añadir">
               <font><Font name="Arial" size="12.0" /></font>
            </Button>
            <Button fx:id="BtnEliminar" layoutX="1090.0" layoutY="260.0" mnemonicParsing="false" onAction="#eliminarDelCarrito" styleClass="boton-naranja" text="Eliminar">
               <font><Font name="Arial" size="12.0" /></font>
            </Button>

            <Button fx:id="Alerts" layoutX="1190.0" layoutY="580.0" mnemonicParsing="false" prefHeight="60.0" prefWidth="60.0" styleClass="boton-navegacion" />

            <Button fx:id="AñadirProd" layoutX="1000.0" layoutY="480.0" mnemonicParsing="false" onAction="#openProductManagement" prefHeight="40.0" prefWidth="150.0" styleClass="boton-naranja" text="Añadir Productos">
               <font><Font name="Arial" size="14.0" /></font>
            </Button>
            <Button fx:id="Regist" layoutX="1000.0" layoutY="540.0" mnemonicParsing="false" onAction="#openRegister" prefHeight="40.0" prefWidth="150.0" styleClass="boton-naranja" text="Registro">
               <font><Font name="Arial" size="14.0" /></font>
            </Button>
            <Button fx:id="Historial" layoutX="1000.0" layoutY="600.0" mnemonicParsing="false" prefHeight="40.0" prefWidth="150.0" styleClass="boton-naranja" text="Historial de Ventas">
               <font><Font name="Arial" size="14.0" /></font>
            </Button>
         </children>
      </Pane>
   </children>
</StackPane>
