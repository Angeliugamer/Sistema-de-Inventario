<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" stylesheets="@../Styles/Botones.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.VentaController">
   <children>
      <Pane prefHeight="200.0" prefWidth="200.0">
         <children>
            <ImageView fitHeight="720.0" fitWidth="1280.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../Shared/1%20Login/Fondo.png" />
               </image>
            </ImageView>
            <ImageView fitHeight="720.0" fitWidth="1280.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../Shared/2%20Lista%20Productos/Coso%20Astetic.png" />
               </image>
            </ImageView>
         </children>
      </Pane>
      <Pane prefHeight="200.0" prefWidth="200.0">
         <children>
            <ImageView fitHeight="56.0" fitWidth="57.0" layoutX="23.0" layoutY="22.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../Icons/SignOut.png" />
               </image>
               <effect>
                  <ColorAdjust brightness="1.0" />
               </effect>
            </ImageView>
            <ImageView fitHeight="60.0" fitWidth="63.0" layoutX="1108.0" layoutY="26.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../Icons/CaretCircleLeft.png" />
               </image>
               <effect>
                  <ColorAdjust brightness="1.0" />
               </effect>
            </ImageView>
            <ImageView fitHeight="96.0" fitWidth="96.0" layoutX="1182.0" layoutY="5.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../Icons/UserCircle.png" />
               </image>
               <effect>
                  <ColorAdjust brightness="1.0" />
               </effect>
            </ImageView>
            <ImageView fitHeight="350.0" fitWidth="400.0" layoutX="865.0" layoutY="155.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../Shared/3%20Venta/No%20lo%20se%20hermano%20dimelo%20tu.png" />
               </image>
            </ImageView>
         </children>
      </Pane>
      <Pane prefHeight="200.0" prefWidth="200.0">
         <children>
            <Button fx:id="Out" layoutX="25.0" layoutY="22.0" mnemonicParsing="false" onAction="#logout" prefHeight="56.0" prefWidth="52.0" styleClass="boton-navegacion" />
            <Button fx:id="Back" layoutX="1108.0" layoutY="26.0" mnemonicParsing="false" onAction="#backToProducts" prefHeight="60.0" prefWidth="60.0" styleClass="boton-navegacion" />

            <AnchorPane prefHeight="720.0" prefWidth="1280.0">
               <Label layoutX="125.0" layoutY="30.0" text="REGISTRO DE VENTAS" textFill="WHITE">
                  <font>
                     <Font name="Arial Black" size="27.0" />
                  </font>
               </Label>
      
               <!-- LISTA DE PRODUCTOS -->
               <VBox layoutX="55.0" layoutY="135.0" prefHeight="500.0" prefWidth="790.0" spacing="5.0">
                  <Label text="Productos de la venta">
                     <font><Font name="Arial Bold" size="18.0" /></font>
                  </Label>
      
                  <GridPane hgap="8.0" prefHeight="30.0">
                     <columnConstraints>
                        <ColumnConstraints percentWidth="30" />
                        <ColumnConstraints percentWidth="20" />
                        <ColumnConstraints percentWidth="18" />
                        <ColumnConstraints percentWidth="16" />
                        <ColumnConstraints percentWidth="16" />
                     </columnConstraints>
      
                     <Label text="PRODUCTO" GridPane.columnIndex="0">
                        <font>
                           <Font name="System Bold" size="12.218181610107422" />
                        </font></Label>
                     <Label text="CATEGORÍA" GridPane.columnIndex="1" />
                     <Label text="PRECIO" GridPane.columnIndex="2" />
                     <Label text="STOCK" GridPane.columnIndex="3" />
                     <Label text="CANT." GridPane.columnIndex="4" />
                     
                     <rowConstraints>
                        <RowConstraints />
                     </rowConstraints>
                  </GridPane>
      
                  <ListView fx:id="ListaVenta" prefWidth="790.0" VBox.vgrow="ALWAYS" />
               </VBox>
      
               <VBox layoutX="890.0" layoutY="175.0" prefWidth="320.0" spacing="10.0">
                  <Label text="RESUMEN DE VENTA">
                     <font>
                        <Font name="Arial Black" size="18.0" />
                     </font>
                  </Label>
                  <Label fx:id="CantidadLabel" text="Unidades: 0">
                     <font>
                        <Font name="Arial" size="16.0" />
                     </font>
                  </Label>
                  <Label fx:id="TotalLabel" text="Total: $0">
                     <font>
                        <Font name="Arial Black" size="25.0" />
                     </font>
                  </Label>
      
                  <Separator />
      
                  <Label text="Modificar cantidad">
                     <font><Font name="Arial Bold" size="14.0" /></font>
                  </Label>
      
                  <TextField fx:id="Cantidad" promptText="Nueva cantidad" />
      
                  <Button maxWidth="Infinity" onAction="#actualizarCantidad" styleClass="boton-naranja" text="Actualizar cantidad" />
               </VBox>
            </AnchorPane>

            <Button fx:id="BtnAñadir" layoutX="890.0" layoutY="400.0" prefHeight="30.0" prefWidth="155.0" mnemonicParsing="false" onAction="#añadirProducto" styleClass="boton-naranja" text="Añadir">
               <font><Font name="Arial" size="12.0" /></font>
            </Button>
            <Button fx:id="BtnEliminar" layoutX="1055.0" layoutY="400.0" prefHeight="30.0" prefWidth="155.0"  mnemonicParsing="false" onAction="#eliminarProducto" styleClass="boton-naranja" text="Eliminar">
               <font><Font name="Arial" size="12.0" /></font>
            </Button>

            <Button fx:id="Continuar" layoutX="890.0" layoutY="550.0" mnemonicParsing="false" onAction="#purchase" prefHeight="40.0" prefWidth="320.0" styleClass="boton-naranja" text="Continuar" />
            <Button fx:id="Historial" layoutX="890.0" layoutY="600.0" mnemonicParsing="false" onAction="#openHistory" prefHeight="40.0" prefWidth="320.0" styleClass="boton-naranja" text="Historial de Ventas">
               <font>
                  <Font name="Arial" size="14.0" />
               </font>
            </Button>
         </children>
      </Pane>
   </children>
</StackPane>
